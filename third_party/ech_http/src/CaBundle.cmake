function(eh_configure_ca_bundle output)
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/cacert.pem" EH_CA_PEM)
  string(LENGTH "${EH_CA_PEM}" EH_CA_LENGTH)
  string(FIND "${EH_CA_PEM}" ")ECH_CA_BUNDLE\"" delimiter_position)
  if(NOT delimiter_position EQUAL -1)
    message(FATAL_ERROR "CA bundle contains the C++ raw string delimiter")
  endif()

  # MSVC 单个字符串限制为 16380 字节；分段追加保留完整证书和 TLS 校验。
  set(EH_CA_APPEND "")
  set(offset 0)
  while(offset LESS EH_CA_LENGTH)
    math(EXPR remaining "${EH_CA_LENGTH} - ${offset}")
    if(remaining GREATER 8192)
      set(chunk_length 8192)
    else()
      set(chunk_length "${remaining}")
    endif()
    string(SUBSTRING "${EH_CA_PEM}" ${offset} ${chunk_length} chunk)
    string(APPEND EH_CA_APPEND "    value.append(R\"ECH_CA_BUNDLE(${chunk})ECH_CA_BUNDLE\");\n")
    math(EXPR offset "${offset} + ${chunk_length}")
  endwhile()
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ca_bundle.h.in" "${output}" @ONLY)
endfunction()
