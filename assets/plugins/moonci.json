{
  "api": "8",
  "type": "anime",
  "sourceId": "moonci",
  "name": "moonci",
  "version": "3.1.0",
  "muliSources": true,
  "useWebview": false,
  "useNativePlayer": true,
  "usePost": false,
  "useLegacyParser": false,
  "adBlocker": false,
  "userAgent": "",
  "baseURL": "https://www.moonci.com/",
  "searchURL": "",
  "searchList": "",
  "searchName": "",
  "searchResult": "",
  "chapterRoads": "",
  "chapterResult": "",
  "referer": "",
  "searchMode": "api",
  "chapterMode": "api",
  "searchApiConfig": {
    "request": {
      "method": "GET",
      "url": "https://source-runtime.playra.invalid/v1/adapters/anifive-d/search",
      "query": {
        "q": "@keyword",
        "page": "@page",
        "pageSize": "@pageSize"
      }
    },
    "listPath": "$.data[*]",
    "namePath": "$.name",
    "sourcePath": "$.url",
    "coverPath": "$.cover"
  },
  "chapterApiConfig": {
    "request": {
      "method": "GET",
      "url": "https://source-runtime.playra.invalid/v1/adapters/anifive-d/episodes",
      "query": {
        "source": "@source"
      }
    },
    "format": "nested",
    "roadsPath": "$.data.roads[*]",
    "roadNamePath": "$.name",
    "episodesPath": "$.episodes[*]",
    "episodeNamePath": "$.name",
    "episodeUrlPath": "$.url",
    "roadIdPath": "$.id"
  },
  "sourceConfig": {
    "domains": [
      "anime"
    ],
    "searchPagination": {
      "enabled": true,
      "totalPath": "$.total",
      "hasMorePath": "$.hasMore"
    },
    "resolveApi": {
      "request": {
        "method": "POST",
        "url": "https://source-runtime.playra.invalid/v1/adapters/anifive-d/resolve",
        "bodyType": "json",
        "body": {
          "episodeUrl": "@episodeUrl"
        }
      },
      "urlPath": "$.data.url",
      "headersPath": "$.data.headers",
      "formatPath": "$.data.format",
      "expiresAtPath": "$.data.expiresAt",
      "headerPolicyPath": "$.data.headerPolicy"
    },
    "contentGroups": [
      "anime"
    ],
    "managedBy": "playra-anifive",
    "bundleVersion": 1
  }
}
